# Examcenter runtime configuration
EXAMCENTER_ENV=production
EXAMCENTER_VERSION=2.0.0
EXAMCENTER_TIMEZONE=Africa/Lagos
EXAMCENTER_BASE_URL=

# Do not commit secrets
EXAMCENTER_LICENSE_SECRET=
EXAMCENTER_API_SECRET=

# Legacy license API (compatibility)
EXAMCENTER_LICENSE_SERVER=

# Pro v2 entitlement server
EXAMCENTER_PRO_SERVER=

EXAMCENTER_SUPPORT_EMAIL=support@examcenter.com
EXAMCENTER_SUPPORT_PHONE=

# Local database
EXAMCENTER_DB_HOST=127.0.0.1
EXAMCENTER_DB_PORT=3307
EXAMCENTER_DB_NAME=cbt_app_db
EXAMCENTER_DB_USER=root
EXAMCENTER_DB_PASSWORD=

# Local offline AI theory marking (llama.cpp; no Ollama required)
# Optional full paths; the runtime also searches common local model cache folders.
EXAMCENTER_LLAMA_SERVER=
EXAMCENTER_LLAMA_MODEL_PATH=
EXAMCENTER_LLAMA_ENDPOINT=http://127.0.0.1:11435
EXAMCENTER_LLAMA_MODEL_ALIAS=qwen3-1.7b
EXAMCENTER_LLAMA_CONTEXT_SIZE=4096
EXAMCENTER_LLAMA_PARALLEL=1
